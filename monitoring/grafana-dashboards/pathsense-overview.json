{
  "id": null,
  "uid": "pathsense-overview",
  "title": "PathSense — System Overview",
  "tags": ["pathsense"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"pathsense-api\"}[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prediction Latency (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"pathsense-api\",path=\"/predict\"}[5m]))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "id": 3,
      "title": "Risk Level Distribution (last hour)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (risk_level) (increase(pathsense_predictions_total[1h]))",
          "legendFormat": "{{risk_level}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "SOS Events (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "increase(pathsense_sos_sent_total[24h])",
          "legendFormat": "SOS messages"
        }
      ]
    }
  ]
}
