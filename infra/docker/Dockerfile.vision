# PathSense v3 — Vision Service (YOLOv8)
# Uses PyTorch CPU image — swap base for GPU if available
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libsm6 libxrender1 libxext6 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r pathsense && useradd -r -g pathsense pathsense

WORKDIR /app

COPY requirements-vision.txt .
RUN pip install --no-cache-dir -r requirements-vision.txt

# Pre-download YOLOv8 nano weights at build time (6MB)
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')" || true

COPY services/vision/ ./services/vision/

ENV YOLO_MODEL_SIZE=yolov8n \
    DANGER_ZONE_M=5.0 \
    WARN_ZONE_M=15.0 \
    PYTHONUNBUFFERED=1

EXPOSE 8002

USER pathsense

HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8002/health')" || exit 1

CMD ["python", "-m", "uvicorn", "services.vision.main:app", \
     "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
