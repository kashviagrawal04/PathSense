# PathSense v2 — Environment variables
# Copy to .env and fill in your values

# ── External APIs ──────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=your_key_here   # https://openweathermap.org/api — free tier is enough

# ── Twilio (SMS alerts) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ── Infrastructure ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://pathsense:pathsense_dev@postgres:5432/pathsense
POSTGRES_PASSWORD=pathsense_dev

# ── ML ─────────────────────────────────────────────────────────────────────────
ALERT_THRESHOLD=0.70
ALERT_COOLDOWN_SEC=60
